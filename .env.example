# Local PostgreSQL (docker compose up --detach --wait)
DATABASE_URL=postgresql://invoicely:invoicely@127.0.0.1:55432/invoicely

# Authentication
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# Cloudflare R2
CF_R2_ENDPOINT=https://replace-with-account-id.r2.cloudflarestorage.com
CF_R2_ACCESS_KEY_ID=replace-with-access-key-id
CF_R2_SECRET_ACCESS_KEY=replace-with-secret-access-key
CF_R2_BUCKET_NAME=replace-with-bucket-name
CF_R2_PUBLIC_DOMAIN=https://replace-with-public-domain.example

# Analytics and public URLs
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=replace-with-posthog-key
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_TRPC_BASE_URL=http://localhost:3000/api/trpc

# Optional build and monitoring values
CONFIG_BUILD_ANALYZE=false
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=
