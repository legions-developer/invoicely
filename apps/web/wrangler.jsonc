{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "invoicely-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "invoicely-web" }],
  "r2_buckets": [{ "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "invoicely-next-cache" }],
  "durable_objects": {
    "bindings": [{ "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DOQueueHandler"] }],
  "images": { "binding": "IMAGES" },
  "observability": { "enabled": true },
  "previews": {
    "vars": { "CLOUDFLARE_PREVIEW": "true" },
    "images": { "binding": "IMAGES" },
  },
  "env": {
    "staging": {
      "name": "invoicely-web-staging",
      "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "invoicely-web-staging" }],
      "r2_buckets": [{ "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "invoicely-next-cache-staging" }],
      "durable_objects": {
        "bindings": [{ "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" }],
      },
      "images": { "binding": "IMAGES" },
    },
  },
}
